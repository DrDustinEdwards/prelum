{
  // The specimen at https://prelum.dustinedwards.info: an assets Worker serving specimen/dist, which `npm run specimen` builds.
  // No account id here: wrangler takes it from the login or from CLOUDFLARE_ACCOUNT_ID. Deploy with `npm run deploy:specimen`.
  // The custom domain below is created by the first deploy; adding it is Dustin's step (conventions 1.7).
  "$schema": "https://unpkg.com/wrangler@4.143.0/config-schema.json",
  "name": "prelum-specimen",
  "compatibility_date": "2026-09-28",
  "main": "./specimen/worker.mjs",
  "assets": {
    "directory": "./specimen/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "prelum.dustinedwards.info", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
