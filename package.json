    },
    "./render/diagram-draw": {
      "types": "./render-diagram-draw.d.mts",
      "default": "./render-diagram-draw.mjs"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "typecheck": "tsc -p .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test \"test/*.test.mjs\"",
    "specimen": "node specimen/build.mjs && node bin/markdown.mjs --dir specimen/dist --origin https://prelum.dustinedwards.info && site-runtime-headers --site prelum --out specimen/dist/_headers --header \"tdm-reservation: 1\"",
    "specimen:diagrams": "node specimen/diagrams.mjs",
    "deploy:specimen": "npm run specimen && npx --yes wrangler@4.143.0 deploy",
    "bloat": "devkit-no-bloat"
  },
