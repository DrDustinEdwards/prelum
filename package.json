    },
    "rehype-katex": {
      "optional": true
    },
    "rehype-slug": {
      "optional": true
    },
    "rehype-stringify": {
      "optional": true
    },
    "remark-directive": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    },
    "remark-parse": {
      "optional": true
    },
    "remark-rehype": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "unified": {
