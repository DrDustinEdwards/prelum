    "./render/url": {
      "types": "./render-url.d.mts",
      "default": "./render-url.mjs"
    },
    "./render/diagram": {
      "types": "./render-diagram.d.mts",
      "default": "./render-diagram.mjs"
    },
    "./render/diagram-draw": {
      "types": "./render-diagram-draw.d.mts",
      "default": "./render-diagram-draw.mjs"
    }
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "bin",
    "README.md"
  ],
  "scripts": {
    "lint": "oxlint *.mjs bin test specimen --deny-warnings",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/*.test.mjs\"",
    "specimen": "node specimen/build.mjs",
    "specimen:diagrams": "node specimen/diagrams.mjs",
    "deploy:specimen": "npm run specimen && npx --yes wrangler@4.143.0 deploy",
    "bloat": "devkit-no-bloat --warn-only"
  },
