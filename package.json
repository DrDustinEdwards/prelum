{
  "name": "@drdustinedwards/site-helpers",
  "version": "0.17.0",
  "description": "The XML escaping, RSS/Atom/JSON feed, sitemap, llms.txt and llms-full.txt, Markdown copy, frontmatter, head tag, JSON-LD, robots.txt, IndexNow, site audit and FTS5 search helpers the Dustin Edwards sites each wrote for themselves, and the markdown pipeline they all render with, once.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./xml": {
      "types": "./xml.d.mts",
      "default": "./xml.mjs"
    },
    "./slug": {
      "types": "./slug.d.mts",
      "default": "./slug.mjs"
    },
    "./feeds": {
      "types": "./feeds.d.mts",
