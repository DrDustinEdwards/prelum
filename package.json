{
  "name": "@drdustinedwards/site-helpers",
  "version": "0.3.1",
  "description": "The XML escaping, RSS/Atom/JSON feed, sitemap, llms.txt and FTS5 search helpers the Dustin Edwards sites each wrote for themselves, and the markdown pipeline they all render with, once.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./xml": {
      "types": "./xml.d.mts",
      "default": "./xml.mjs"
    },
    "./feeds": {
      "types": "./feeds.d.mts",
      "default": "./feeds.mjs"
    },
    "./sitemap": {
      "types": "./sitemap.d.mts",
      "default": "./sitemap.mjs"
    },
    "./llms": {
      "types": "./llms.d.mts",
      "default": "./llms.mjs"
    },
    "./search": {
      "types": "./search.d.mts",
      "default": "./search.mjs"
    },
    "./render": {
      "types": "./render.d.mts",
      "default": "./render.mjs"
    },
    "./render/packs": {
      "types": "./render-packs.d.mts",
      "default": "./render-packs.mjs"
    },
    "./render/highlight": {
      "types": "./render-highlight.d.mts",
      "default": "./render-highlight.mjs"
    },
    "./render/safe": {
      "types": "./render-safe.d.mts",
      "default": "./render-safe.mjs"
    },
    "./render/conformance": {
      "types": "./render-conformance.d.mts",
      "default": "./render-conformance.mjs"
    },
    "./render/math": {
      "types": "./render-math.d.mts",
      "default": "./render-math.mjs"
    },
    "./render/url": {
      "types": "./render-url.d.mts",
      "default": "./render-url.mjs"
    }
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "README.md"
  ],
  "scripts": {
    "lint": "oxlint *.mjs test specimen --deny-warnings",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/*.test.mjs\"",
    "specimen": "node specimen/build.mjs",
    "specimen:diagrams": "node specimen/diagrams.mjs",
    "deploy:specimen": "npm run specimen && npx --yes wrangler@4.143.0 deploy"
  },
  "peerDependencies": {
    "@shikijs/rehype": "4.5.0",
    "@shikijs/transformers": "4.5.0",
    "enarratio": "0.1.0-alpha.8",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-string": "3.0.1",
    "katex": "0.16.47",
    "parse5": "7.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "peerDependenciesMeta": {
