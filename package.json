      "types": "./sitemap.d.mts",
      "default": "./sitemap.mjs"
    },
    "./accessibility": {
      "types": "./accessibility.d.mts",
      "default": "./accessibility.mjs"
    },
    "./llms": {
      "types": "./llms.d.mts",
      "default": "./llms.mjs"
    },
    "./markdown-copy": {
      "types": "./markdown-copy.d.mts",
      "default": "./markdown-copy.mjs"
    },
    "./markdown-files": {
      "types": "./markdown-files.d.mts",
      "default": "./markdown-files.mjs"
    },
    "./frontmatter": {
      "types": "./frontmatter.d.mts",
      "default": "./frontmatter.mjs"
    },
    "./head": {
      "types": "./head.d.mts",
      "default": "./head.mjs"
    },
    "./scholar": {
      "types": "./scholar.d.mts",
      "default": "./scholar.mjs"
    },
    "./vtt": {
      "types": "./vtt.d.mts",
      "default": "./vtt.mjs"
    },
    "./schema": {
      "types": "./schema.d.mts",
      "default": "./schema.mjs"
    },
    "./robots": {
      "types": "./robots.d.mts",
      "default": "./robots.mjs"
