{
  "name": "@drdustinedwards/site-helpers",
  "version": "0.53.0",
  "description": "The XML escaping, RSS/Atom/JSON feed, sitemap, llms.txt and llms-full.txt, Markdown copy, frontmatter, head tag, JSON-LD, robots.txt, IndexNow, site audit and FTS5 search helpers the Dustin Edwards sites each wrote for themselves, and the markdown pipeline they all render with, once.",
  "license": "MIT",
  "bin": {
    "prelum-audit": "./bin/audit.mjs",
    "prelum-chart-audit": "./bin/chart-audit.mjs",
    "prelum-content": "./bin/content.mjs",
    "prelum-icons": "./bin/icons.mjs",
    "prelum-indexnow": "./bin/indexnow.mjs",
    "prelum-lastmod": "./bin/lastmod.mjs",
    "prelum-markdown": "./bin/markdown.mjs"
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "bin",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./xml": {
      "types": "./xml.d.mts",
      "default": "./xml.mjs"
    },
    "./slug": {
      "types": "./slug.d.mts",
