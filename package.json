      "types": "./render-safe.d.mts",
      "default": "./render-safe.mjs"
    },
    "./render/enhance": {
      "types": "./render-enhance.d.mts",
      "default": "./render-enhance.mjs"
    },
    "./render/embeds": {
      "types": "./render-embeds.d.mts",
      "default": "./render-embeds.mjs"
    },
    "./render/audit": {
      "types": "./render-audit.d.mts",
      "default": "./render-audit.mjs"
    },
    "./render/conformance": {
      "types": "./render-conformance.d.mts",
      "default": "./render-conformance.mjs"
    },
    "./render/math": {
      "types": "./render-math.d.mts",
      "default": "./render-math.mjs"
    },
    "./render/url": {
      "types": "./render-url.d.mts",
      "default": "./render-url.mjs"
