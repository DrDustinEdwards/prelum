    },
    "unist-util-visit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@shikijs/rehype": "4.5.0",
    "@shikijs/transformers": "4.5.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.10.1",
    "enarratio": "0.1.0-alpha.8",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-string": "3.0.1",
    "katex": "0.16.47",
    "oxlint": "1.88.0",
    "parse5": "7.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
