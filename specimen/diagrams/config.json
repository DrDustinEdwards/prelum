{
  "mermaidCli": "@mermaid-js/mermaid-cli@11.16.0",
  "light": {
    "theme": "base",
    "themeVariables": {
      "darkMode": false,
      "background": "#fdfdfe",
      "primaryColor": "#ece5ff",
      "primaryTextColor": "#1c1727",
      "primaryBorderColor": "#9780c3",
      "secondaryColor": "#f7f6fc",
      "tertiaryColor": "#f7f6fc",
      "lineColor": "#918e96",
      "textColor": "#1c1727",
